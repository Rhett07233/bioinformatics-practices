# 配置：大肠杆菌 WGS —— 用来快速验证整条流程能不能跑通
#
# 数据量只有约 255 MB，参考基因组 1.3 MB，
# 从下载到出 VCF 通常 20~30 分钟，适合先跑这个确认环境没问题。

SAMPLES=samples/ecoli.tsv

# 参考基因组：E. coli K-12 MG1655，NCBI RefSeq GCF_000005845.2
REF_URL=https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/005/845/GCF_000005845.2_ASM584v2/GCF_000005845.2_ASM584v2_genomic.fna.gz
REF_NAME=ecoli_k12_mg1655
REF=ref/ecoli_k12_mg1655.fa

BED=

# 注释库示例：先运行 snpEff databases | grep -i Escherichia 确认可用名
SNPEFF_DB=

THREADS=8

# 大肠杆菌是单倍体，必须用 --ploidy 1 调用。
# 默认的二倍体模型会产生 0/1 杂合基因型（单倍体不可能有）并虚高 SNP 数。
PLOIDY=1
